{
  "name": "claudia",
  "version": "5.14.1",
  "description": "Deploy Node.js projects to AWS Lambda and API Gateway easily.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/claudiajs/claudia.git"
  },
  "bin": {
    "claudia": "./bin/cmd.js"
  },
  "main": "index.js",
  "keywords": [
    "claudia",
    "aws",
    "lambda",
    "apigateway",
    "s3",
    "api",
    "microservices",
    "serverless"
  ],
  "bugs": {
    "url": "https://github.com/claudiajs/claudia/issues"
  },
  "homepage": "https://github.com/claudiajs/claudia",
  "files": [
    "src",
    "logo.png",
    "*.md",
    "*.js",
    "app-templates",
    "json-templates",
    "bin",
    "docs"
  ],
  "scripts": {
    "prepublishOnly": "npm shrinkwrap && node src/util/doc-md.js",
    "pretest": "eslint .",
    "test": "node spec/support/jasmine-runner.js",
    "test:unit": "node spec/support/unit-test-runner.js",
    "debug": "node --debug-brk --inspect spec/support/jasmine-runner.js",
    "integration-build": "aws codebuild start-build --project-name claudiajs --region us-west-2 --profile claudia-test",
    "integration-results": "aws s3 cp s3://claudiatestresults/claudiajs/buildresult.txt . --profile claudia-test",
    "integration-build-status": "aws codebuild batch-get-builds --ids $(aws codebuild list-builds-for-project --project-name claudiajs --profile claudia-test --region us-west-2 --query 'ids[0]' --output text) --region us-west-2 --profile claudia-test --query 'builds[].buildStatus' --output text"
  },
  "author": "Gojko Adzic <gojko@gojko.com> (http://gojko.net)",
  "contributors": [
    "Slobodan Stojanovic <slobodan@cloudhorizon.com> (http://slobodan.me)",
    "Alexander Simovic (https://github.com/simalexan)"
  ],
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1026.0",
    "@aws-sdk/client-cloudfront": "^3.1026.0",
    "@aws-sdk/client-cloudwatch-events": "^3.1026.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1026.0",
    "@aws-sdk/client-iam": "^3.1026.0",
    "@aws-sdk/client-iot": "^3.1026.0",
    "@aws-sdk/client-kinesis": "^3.1026.0",
    "@aws-sdk/client-lambda": "^3.1026.0",
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/client-sns": "^3.1026.0",
    "@aws-sdk/client-sqs": "^3.1026.0",
    "@aws-sdk/client-sts": "^3.1026.0",
    "@aws-sdk/credential-providers": "^3.1026.0",
    "@aws-sdk/lib-storage": "^3.1026.0",
    "archiver": "^7.0.1",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "gunzip-maybe": "^1.4.0",
    "https-proxy-agent": "^5.0.0",
    "minimal-request-promise": "^1.1.0",
    "minimist": "^1.2.5",
    "oh-no-i-insist": "^1.1.1",
    "sequential-promise-map": "^1.0.0",
    "tar-fs": "^2.1.1",
    "uuid": "^14.0.0",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1026.0",
    "@aws-sdk/client-ec2": "^3.1026.0",
    "@aws-sdk/client-iot-data-plane": "^3.1026.0",
    "@eslint/js": "^9.39.4",
    "decompress": "^4.2.0",
    "dotenv": "^2.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "jasmine": "^5.13.0",
    "jasmine-spec-reporter": "^7.0.0"
  },
  "overrides": {
    "archiver-utils": {
      "glob": "^13.0.6"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
